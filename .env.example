# Copy to .env and fill in. The canonical .env lives at the repo root
# (CLAUDE.md §2); .env is gitignored. Nothing here has a built-in default for a
# required value — a missing or malformed one stops startup by name.

# --- Database ---------------------------------------------------------------
# The dev and test databases the docker-compose stack creates on loopback.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/home_renovation
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/home_renovation_test

# --- Model gateway ----------------------------------------------------------
# The single OpenRouter credential every model call is routed through
# (CLAUDE.md §2). Never a vendor-native key.
OPENROUTER_API_KEY=sk-or-v1-change-me

# --- Browser origins --------------------------------------------------------
# Comma-separated. Credentialed CORS needs explicit origins; `*` is refused.
CORS_ORIGINS=http://localhost:5173

# --- Owner account ----------------------------------------------------------
# The single owner, created from these on first start. OWNER_PASSWORD is the
# initial password only (at least ten characters); a later change survives
# restarts because the stored hash is never overwritten.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-please

# --- Developer panel --------------------------------------------------------
# When false, every /admin route answers 404 so the homeowner surface shows no
# sign of it. Turn on for the owner's own machine.
DEV_PANEL_ENABLED=false

# --- Startup gateway probe --------------------------------------------------
# One minimal call per routed model at startup. On by default; turn off for
# offline boots and tests.
GATEWAY_PROBE_ENABLED=true

# --- Session cookie ---------------------------------------------------------
# Whether the session cookie carries `Secure`. Off for loopback plain-HTTP
# development; a deployment behind HTTPS must turn this on.
SESSION_COOKIE_SECURE=false
# How long a sign-in lasts, sliding forward as it is used.
AUTH_SESSION_DAYS=14
# Sign-in attempts per address and per network within the window.
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Blender and renders ----------------------------------------------------
# The pinned Blender 5.2.1 LTS. A host without it still boots; only starting a
# build or render is refused (503).
# BLENDER_BIN=/home/pingu/Applications/blender-5.2.1-linux-x64/blender
# Longest a single Blender process may run, in seconds.
BLENDER_TIMEOUT_SECONDS=600
# Where package versions and renders are written (contents gitignored).
# RENDER_ROOT=/home/pingu/Applications/Home_Renovation_Agents/docs/renders

# --- The live Blender (photoreal detail pass) ---------------------------------
# Where the Blender "MCP for Blender" addon listens. Loopback only: it is your own
# Blender, on this machine. Scripts are refused while a headless job runs.
# BLENDER_LIVE_HOST=127.0.0.1
# BLENDER_LIVE_PORT=9876
# Longest one live command may take, in seconds.
# BLENDER_LIVE_TIMEOUT_SECONDS=120

# --- Render offload (optional) ------------------------------------------------
# A rented GPU box for `final` renders, reached with the system `ssh` (key only, host key
# pinned in a known-hosts file you provide). Off unless the first five are all set. See the
# README. Blender 5.2.1 must be installed there.
# RENDER_OFFLOAD_HOST=
# RENDER_OFFLOAD_USER=
# RENDER_OFFLOAD_KEY_PATH=
# RENDER_OFFLOAD_KNOWN_HOSTS_PATH=
# RENDER_OFFLOAD_BLENDER=/opt/blender-5.2.1-linux-x64/blender
# RENDER_OFFLOAD_PORT=22
# RENDER_OFFLOAD_CYCLES_DEVICE=OPTIX

# --- HTTPS plugins ----------------------------------------------------------
# Comma-separated hosts an HTTPS plugin may call. Empty: none are allow-listed.
PLUGIN_ALLOWED_HOSTS=
PLUGIN_TIMEOUT_SECONDS=5
PLUGIN_MAX_RESPONSE_BYTES=262144
PLUGIN_MIN_INTERVAL_SECONDS=0.5

# --- Token budget -----------------------------------------------------------
# IANA time zone for the daily token ceiling's midnight.
BUDGET_TIMEZONE=Europe/Berlin

# --- Tracing (optional) -----------------------------------------------------
# Langfuse. All three must be set for tracing to run at all; with any absent the
# service starts and answers exactly as before. An unreachable Langfuse never
# delays or fails a turn.
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_TRACING_ENVIRONMENT=development

# --- Uploads (blueprints and photos attached to a conversation) -------------
# Files live here, never in conversation state. Defaults shown.
# UPLOAD_ROOT=docs/uploads
# The owner's own guideline files (pdf/ and notes/), listed in config/guideline_sources.yaml.
# GUIDELINE_ROOT=docs/guidelines
# UPLOAD_MAX_BYTES=10485760
# UPLOAD_MAX_PER_THREAD=20
# TURN_MAX_IMAGES=4

# --- Retail sources and pricing -----------------------------------------------
# toom is the only permitted source (Bauhaus, Kaufland and OKI are excluded).
# RETAIL_SOURCES=toom
# Sent in the crawler's User-Agent so a site can reach you; defaults to OWNER_EMAIL.
# CRAWLER_CONTACT=
# TODO(user): the toom store whose cut services and restrictions price a cut list.
# TOOM_HOME_STORE=berlin-friedrichshain
# INGESTION_PAGE_BUDGET=50
# INGESTION_MIN_INTERVAL_SECONDS=1.0
# Requests that each read a retailer page (paste a URL, refresh a price) per window.
# RATE_LIMIT_PRICE_FETCH=10
# RATE_LIMIT_PRICE_FETCH_WINDOW_SECONDS=60
