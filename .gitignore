.venv/
__pycache__/
*.pyc
.env
frontend/node_modules/
frontend/dist/
# renders are generated output; keep the folder, ignore its contents
docs/renders/*
!docs/renders/.gitkeep

# uploads are the owner's own files; keep the folder, ignore its contents
docs/uploads/*
!docs/uploads/.gitkeep
# The owner's own guideline PDFs (licences vary); notes/ may be committed.
docs/guidelines/pdf/*
!docs/guidelines/pdf/.gitkeep

# Unapproved explore notes; adopt via OpenSpec before committing.
docs/blueprint-input-notes.md

# Hidden until the build has a workable version; the file stays on disk.
/README.md
